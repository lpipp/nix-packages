+/* Linux 6.6 delivers the integer value instead of an ACPI object. */
+static void huawei_wmi_input_notify_legacy(u32 value, void *context)
+{
+	union acpi_object event = { .type = ACPI_TYPE_INTEGER };
+
+	event.integer.value = value;
+	huawei_wmi_input_notify(&event, context);
+}
